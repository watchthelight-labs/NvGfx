NvGfx fixup on top of nvk-macos.patch: nv_push.h is also compiled by mesa_clc (src/nouveau/vulkan/cl/nvk_copy_indirect.cl).
OpenCL has no stderr/fprintf, and a function-scope static becomes a CrossWorkgroup global with an initializer that
vtn_bindgen2 rejects (it then crashes), so the zero-count warn-once only exists on the CPU side.

--- a/src/nouveau/headers/nv_push.h
+++ b/src/nouveau/headers/nv_push.h
@@ -132,6 +132,7 @@
     * vk_meta_draw_volume) reached here with an empty method and aborted Chess,
     * mediaanalysisd and several video apps.  Warn once and continue, as the
     * stale rasterization-samples assert in nvk_cmd_draw.c was downgraded. */
+#ifndef __OPENCL_VERSION__
    if (last_count == 0) {
       static int warned;
       if (!warned) {
@@ -139,6 +140,9 @@
          fprintf(stderr, "nvk: empty push method header (count 0); continuing\n");
       }
    }
+#else
+   (void)last_count;
+#endif
 }
 
 static inline void
